    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Journal", "url": "./app.html#journal", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Abonnements", "url": "./app.html#abonnements", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
